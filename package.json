{
  "name": "@narrative/canon",
  "version": "0.1.0",
  "private": true,
  "description": "A cinematic, agent-first studio for authoring worlds, scripts, storyboards, comics, and films",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "npm run clean && npm run build:api && npm run build:ui",
    "build:api": "npm run build:bundle",
    "build:ui": "npm --prefix ui run build",
    "build:bundle": "node esbuild.config.js",
    "build:bundle:watch": "node esbuild.config.js watch",
    "clean": "rm -rf dist",
    "test": "npm run test:root && npm run test:ui",
    "test:root": "jest --config jest.config.cjs --runInBand",
    "test:root:ci": "jest --config jest.config.cjs --runInBand --no-cache --detectOpenHandles",
    "test:ui": "npm --prefix ui test",
    "test:ci": "npm run test:root:ci && npm run test:ui",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "migrate:mongodb": "node scripts/migrate-to-mongodb.mjs",
    "test:integration": "jest --config jest.config.cjs --testPathPattern=integration",
    "test:unit": "jest --config jest.config.cjs --testPathPattern=test --testPathIgnorePatterns=integration",
    "typecheck": "npm run typecheck:root && npm run typecheck:ui",
    "typecheck:root": "tsc -p tsconfig.json --noEmit --pretty false",
    "typecheck:ui": "npm --prefix ui run typecheck",
    "check": "npm run test:ci && npm run typecheck",
    "verify": "npm run check && npm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "game": "node prototypes/timeline-warfare/dist/timeline-warfare.cjs",
    "game:git": "node prototypes/timeline-warfare/dist/timeline-warfare-git.cjs",
    "game:dev": "npm run game:build && npm run game:git",
    "api": "npm run build:bundle && node dist/api-server.cjs",
    "api:dev": "tsx watch src/api/server.ts",
    "api:game:dev": "tsx prototypes/timeline-warfare/src/api/game-server.ts",
    "api:demo": "tsx src/api/server.ts",
    "ui": "cd ui && npm run dev",
    "dev": "concurrently --names 'API,UI' --prefix-colors 'cyan,magenta' 'npm run api:dev' 'npm run ui'",
    "dev:game": "concurrently --names 'GAME,UI' --prefix-colors 'cyan,magenta' 'npm run api:game:dev' 'npm run ui'",
    "prestart": "node scripts/check-build-ready.mjs",
    "start": "concurrently --names 'API,UI' --prefix-colors 'cyan,magenta' 'node dist/api-server.cjs' 'npm --prefix ui run start'",
    "game:build": "node prototypes/timeline-warfare/esbuild.config.js"
  },
  "keywords": [
    "narrative",
    "timeline",
    "canon",
    "storytelling",
    "story-authoring",
    "filmmaking",
    "storyboard",
    "temporal-graph",
    "narrative-ai"
  ],
  "author": "Project 89",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.25.5",
    "esbuild-node-externals": "^1.18.0",
    "jest": "^29.5.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.0.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "^1.35.0",
    "@openai/codex": "^0.94.0",
    "@types/multer": "^2.0.0",
    "chalk": "^4.1.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "mongoose": "^8.15.1",
    "multer": "^2.0.2",
    "openai": "^6.39.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.3",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/project89/narrative-canon.git"
  },
  "bugs": {
    "url": "https://github.com/project89/narrative-canon/issues"
  },
  "homepage": "https://github.com/project89/narrative-canon#readme"
}
