# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Model preference
# Options: gemini-1.5-flash (fast), gemini-1.5-pro (smart)
# GEMINI_MODEL=gemini-1.5-flash

# ============================================================================
# Storage Configuration
# ============================================================================

# Enable MongoDB storage (set to 'true' to use MongoDB, otherwise uses file-based storage)
USE_MONGODB=false

# MongoDB connection string (required if USE_MONGODB=true)
# For local development: mongodb://localhost:27017/narrative_canon
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/narrative_canon
MONGODB_URI=mongodb://localhost:27017/narrative_canon

# Optional: Custom data directory for file-based storage
# DATA_DIR=/path/to/data

# API Server Port
# API_PORT=3088
