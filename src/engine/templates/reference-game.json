  "rules": [
    {
      "id": "check_win",
      "description": "Player wins when dragon_damage_dealt reaches 10",
      "trigger": { "id": "*" },
      "conditions": [{ "id": "GAME", "stats": [{ "key": "dragon_damage_dealt", "gte": 15 }] }],
