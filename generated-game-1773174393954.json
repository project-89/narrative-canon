      "name": "The Torchbearer",
      "description": "A flicker of defiance in the encroaching gloom. Your resolve is your greatest weapon, and your torch, your only hope."
    },
    {
      "id": "monster_goblin_1",
      "type": "monster",
      "name": "Gloom-Touched Goblin",
      "description": "Its eyes gleam with a feral, unsettling intelligence born of the dark, its skin a mottled grey from the dungeon's foul air. A minor pest, yet a potent distraction.",
      "hp": 5,
      "attack": 2,
      "is_active": false
    },
    {
      "id": "monster_goblin_2",
      "type": "monster",
      "name": "Shadow-Stalker Goblin",
      "description": "More twisted and gaunt than its lesser kin, this goblin moves with unnatural swiftness, its chittering laughter echoing unnervingly in the dark, seeking to fray your nerves.",
      "hp": 7,
      "attack": 3,
      "is_active": false
    },
    {
      "id": "monster_boss_lich",
      "type": "monster",
      "name": "Lich Lord Morwen",
      "description": "A skeletal hand clutches a staff crackling with dark energy, his empty eye sockets burning with a cold, malevolent light. Centuries of undeath have only sharpened his intellect and deepened his malice. The source of all despair in this blighted realm.",
      "hp": 30,
      "attack": 5,
      "is_active": false
    },
    {
      "id": "card_attack",
      "type": "card",
      "name": "Strike True",
      "description": "Channel your strength and resolve. Deal 3 damage.",
      "flavor_text": "Even in despair, the blade finds its mark. A clean blow can cut through the gloom, if only for a moment.",
      "cost_ap": 1
    },
    {
      "id": "card_light_torch",
      "type": "card",
      "name": "Stoke the Flame",
      "description": "Fan the embers, push back the encroaching shadows. Restore 3 torch.",
      "flavor_text": "A small spark against the vast night. Keep the flame alive, for without it, only madness awaits.",
      "cost_ap": 1
    },
    {
      "id": "card_calm_mind",
      "type": "card",
      "name": "Iron Will",
      "description": "Focus amidst the whispers. Restore 2 sanity, but the effort takes a toll. Lose 1 sanity.",
      "flavor_text": "The labyrinth seeks to break your mind. Push back against the insidious dread, reaffirm your purpose. The cost is minor compared to the abyss.",
      "cost_ap": 1,
      "cost_sanity": 1
    },
    {
      "id": "card_explore",
      "type": "card",
      "name": "Venture Deeper",
      "description": "Brave the unknown, push further into the cursed depths. Move to the next room.",
      "flavor_text": "Every step forward is a plunge into deeper shadow, a test of courage. What horrors or desperate hopes lie beyond this threshold?",
      "cost_ap": 1
    },
    {
      "id": "card_fortify",
      "type": "card",
      "name": "Brace for Impact",
      "description": "Shrug off the blow. Gain 3 Block this turn.",
      "flavor_text": "Against the crushing darkness, your will is a shield. Stand firm, even if the dread lingers.",
      "cost_ap": 1
    }
  ],
