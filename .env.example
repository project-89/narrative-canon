# Core model provider (set either key; GEMINI_API_KEY is preferred)
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=

# Optional model routing overrides. Leave blank to use the checked-in registry.
# GEMINI_CHAT_MODEL=
# GEMINI_FAST_MODEL=
GEMINI_FAST_MODE=false

# Optional AtlasCloud media backends
ATLASCLOUD_API_KEY=
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1

# Optional direct OpenAI image fallback. AtlasCloud remains the default route.
OPENAI_API_KEY=
ALLOW_OPENAI_DIRECT_FALLBACK=false
# OPENAI_IMAGE_MODEL_GENERATE=
# OPENAI_IMAGE_MODEL_EDIT=

# Optional legacy Seedance route (Replicate)
REPLICATE_API_TOKEN=

# Local API boundary
API_HOST=127.0.0.1
API_PORT=3088
CORS_ALLOWED_ORIGINS=http://localhost:3089,http://127.0.0.1:3089
ALLOW_REMOTE_API=false

# Canonical file store. Relative paths resolve from the repository cwd.
DATA_DIR=.narrative-data

# MongoDB is intentionally disabled: the legacy adapter is not lossless.
USE_MONGODB=false

# Optional runtime identity and diagnostics
NIT_AUTHOR_NAME=studio-user
NARRATIVE_DEBUG_TOOLS=false

# Optional explicit ffmpeg binary; bundled ffmpeg is used when available.
# FFMPEG_PATH=/absolute/path/to/ffmpeg
